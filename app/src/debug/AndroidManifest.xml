        <provider android:authorities="com.readroid.f130fixture.provider" />
    </queries>
    <application>
        <!-- Debug-only fixed-source import probe, never in production APK. -->
        <activity android:name=".F130CrashHarnessActivity"
            android:exported="true" />
    </application>
</manifest>
