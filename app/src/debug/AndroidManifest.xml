<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- CI-only debug visibility of the disposable remote crash provider.
         Not merged into main/release/QA manifests and grants no URI access. -->
    <queries>
        <provider android:authorities="com.readroid.f130fixture.provider" />
    </queries>
    <application>
        <!-- Debug-only fixed-source import probe, never in production APK. -->
        <activity android:name=".F130CrashHarnessActivity"
            android:exported="true" />
        <!-- Fixed-identity checkpoint probe, debug build only. -->
        <activity android:name=".F132CheckpointHarnessActivity"
            android:exported="true" />
        <!-- F1.35 emulator-only verifier interruption, debug build only. -->
        <activity android:name=".F135VerifierCrashHarnessActivity"
            android:exported="true" />
        <!-- F1.39 post-rename/pre-fsync process-kill probe; debug only. -->
        <activity android:name=".F139PostRenameCrashHarnessActivity"
            android:exported="true" />
        <!-- F1.40 only-debug post-fsync real process termination. -->
        <activity android:name=".F140PostSyncCrashHarnessActivity"
            android:exported="true" />
    </application>
</manifest>
